# Contactformulier-bezorging via Web3Forms (gratis: https://web3forms.com)
#
# De huidige key zit al als default in de code
# (src/components/ContactForm.tsx), dus het formulier werkt zonder dat je
# hier iets invult - ook op productie.
#
# Wil je een andere key gebruiken (bv. ander ontvang-adres)? Haal er een op
# via https://web3forms.com en zet 'm hieronder; die overschrijft de default.
# Let op: NEXT_PUBLIC_ wordt tijdens de build ingebakken, dus zet 'm vóór je
# bouwt/deployt. Web3Forms-keys mogen publiek zijn (client-side gebruik).
NEXT_PUBLIC_WEB3FORMS_KEY=

# --- Teamplanning (/planning) ---
#
# Toegangscode voor de afgeschermde planningpagina. Verplicht: zonder deze
# variabele blijft de pagina dicht en kan niemand inloggen.
PLANNING_PASSWORD=

# MongoDB connection string (gratis cluster via https://www.mongodb.com/atlas).
# Zonder deze variabele werkt de planningpagina wel, maar kan er niets
# opgeslagen worden. Zet 'm ook in de Vercel-omgeving.
# Voorbeeld: mongodb+srv://gebruiker:wachtwoord@cluster0.xxxxx.mongodb.net
MONGODB_URI=

# Optioneel: databasenaam (standaard "ruimingswerken").
MONGODB_DB=
